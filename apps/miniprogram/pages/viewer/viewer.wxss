.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 10px 12px;
  box-sizing: border-box;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.seg {
  display: flex;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  overflow: hidden;
}

.seg-item {
  padding: 6px 14px;
  background: #ffffff;
  font-size: 13px;
}

.seg-item.on {
  background: #2563eb;
  color: #ffffff;
}

.info {
  color: #6b7280;
  font-size: 12px;
}

.canvas-wrap {
  flex: 1;
  min-height: 0;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  overflow: hidden;
  background: #eef0f3;
}

.board {
  width: 100%;
  height: 100%;
}

.panel {
  margin-top: 8px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 10px;
}

.panel button {
  display: inline-block;
  margin: 4px 4px 4px 0;
}

.chk {
  margin-right: 12px;
  font-size: 13px;
}

.progress {
  font-size: 13px;
  color: #374151;
  margin-bottom: 6px;
}

.actions {
  margin-bottom: 6px;
}

.steps {
  max-height: 30vh;
  border-top: 1px solid #f3f4f6;
  padding-top: 6px;
}

.step {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 13px;
}

.step.on {
  background: #eff6ff;
  outline: 1px solid #2563eb;
}

.step.done {
  opacity: 0.45;
}

.swatch {
  width: 16px;
  height: 16px;
  border: 1px solid rgba(0, 0, 0, 0.15);
  border-radius: 3px;
  flex: none;
}

.step .code {
  flex: 1;
}

.step .n {
  color: #6b7280;
  font-variant-numeric: tabular-nums;
}

.colors {
  display: flex;
  white-space: nowrap;
  margin: 6px 0;
  width: 100%;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  margin-right: 6px;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  font-size: 11px;
  flex: none;
}

.chip.on {
  border-color: #2563eb;
  background: #eff6ff;
}

.sw2 {
  width: 14px;
  height: 14px;
  border: 1px solid rgba(0, 0, 0, 0.15);
  border-radius: 3px;
  flex: none;
}

.chip-code {
  color: #4b5563;
}

.edit-hint {
  color: #6b7280;
  font-size: 11px;
  margin-top: 4px;
}
